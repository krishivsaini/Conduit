# ── Conduit host configuration ──────────────────────────────────────────────
# Copy to `.env` and fill in. The server itself needs no secrets; only the
# host's LLM adapter does. The fully-local Ollama path needs no key at all.

# Which LLM the host uses to select tools: "gemini" (free tier, default) or
# "ollama" (fully local, offline, zero external dependency).
LLM_PROVIDER=gemini

# ── Gemini (google-genai) ────────────────────────────────────────────────────
# Free API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Ollama (local) ───────────────────────────────────────────────────────────
# Requires `ollama serve` running and a tool-capable model pulled
# (e.g. `ollama pull mistral`).
OLLAMA_MODEL=mistral
OLLAMA_HOST=http://localhost:11434

# ── The repository the MCP server exposes ────────────────────────────────────
# Defaults to the bundled sample-repo. Point at any repo to serve it instead.
CONDUIT_REPO_ROOT=./sample-repo
